<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@drawable/cv2"
        tools:context=".mainact">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/contentLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="0dp">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="@drawable/tolbar"
                android:elevation="8dp"
                app:popupTheme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
                app:contentInsetStart="0dp"
                app:contentInsetLeft="0dp"
                tools:ignore="MissingConstraints">

                <!-- Conteneur horizontal pour logo + texte -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:layout_gravity="center_vertical"
                        app:cardCornerRadius="30dp"
                        app:cardElevation="4dp"
                        app:cardPreventCornerOverlap="true"
                        app:cardUseCompatPadding="true">

                        <ImageView
                            android:id="@+id/logo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/logo" />
                    </androidx.cardview.widget.CardView>


                    <!-- Titre de la barre -->
                    <TextView
                        android:id="@+id/toolbar_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="@string/title"
                        android:textSize="26sp"
                        android:textColor="#F2F2E8E8"
                        android:textStyle="bold"
                        android:shadowColor="#80000000"
                        android:shadowDx="2"
                        android:shadowDy="2"
                        android:shadowRadius="3" />
                </LinearLayout>
            </androidx.appcompat.widget.Toolbar>


            <!-- Images (immédiatement après Toolbar) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardViewImages"
                android:layout_width="match_parent"
                android:layout_height="500sp"
                app:cardCornerRadius="0dp"
                app:layout_constraintTop_toBottomOf="@id/toolbar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_margin="0dp">

                <ImageView
                    android:id="@+id/imageView"
                    android:layout_margin="0dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:adjustViewBounds="false"
               />
            </androidx.cardview.widget.CardView>
            <LinearLayout
                android:id="@+id/dotsLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/cardViewImages"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
            <!-- Titre (après les images) -->
            <TextView
                android:id="@+id/tvTitle"
                style="@style/TitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/welc"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/cardViewImages"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Description -->
            <TextView
                android:id="@+id/tvDescription"
                style="@style/DescriptionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:background="@drawable/gradient_bg"
                android:gravity="center"
                android:padding="10dp"
                android:layout_margin="7dp"
                android:layout_marginTop="5dp"
                app:layout_constraintTop_toBottomOf="@id/tvTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Team -->
            <TextView
                style="@style/TeamText"
                android:id="@+id/tvTeam"
                android:background="@drawable/buttonts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tem"
                android:layout_marginTop="50dp"
                app:layout_constraintTop_toBottomOf="@id/tvDescription"
                app:layout_constraintStart_toStartOf="parent"/>

            <!-- Membres -->
            <TextView
                style="@style/TeamText"
                android:id="@+id/tvMembers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prn"
                android:layout_margin="10dp"
                app:layout_constraintTop_toBottomOf="@id/tvTeam"
                app:layout_constraintStart_toStartOf="parent"/>

            <LinearLayout
                android:id="@+id/navigationIcons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="25dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:background="@drawable/tolbar"
                android:padding="8dp"
                app:layout_constraintTop_toBottomOf="@id/tvMembers"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Infos -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="6dp">

                    <ImageView
                        android:id="@+id/information"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:src="@drawable/information"
                        android:scaleType="fitCenter"
                        android:contentDescription="Info"
                        android:clickable="true"
                        android:focusable="true"
                        android:onClick="goToInfoPage" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/info"
                        android:textColor="#FFFFFFFF"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:shadowColor="#AA000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="1.5"
                        android:onClick="goToInfoPage"
                        style="@style/TeamText" />
                </LinearLayout>

                <!-- Langue -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="6dp">

                    <ImageView
                        android:id="@+id/iconLang"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:src="@drawable/langue"
                        android:scaleType="fitCenter"
                        android:contentDescription="Langue"
                        android:clickable="true"
                        android:focusable="true"
                        android:onClick="switchLanguage" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/lang"
                        android:textColor="#FFFFFFFF"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:shadowColor="#AA000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="1.5"
                        android:onClick="switchLanguage"
                        style="@style/TeamText" />
                </LinearLayout>

                <!-- Carte -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="6dp">

                    <ImageView
                        android:id="@+id/iconMap"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:src="@drawable/pos"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/map"
                        android:clickable="true"
                        android:focusable="true"
                        android:onClick="openGoogleMapsNavigation" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/map"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:shadowColor="#AA000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="1.5"
                        android:onClick="openGoogleMapsNavigation"
                        style="@style/TeamText" />
                </LinearLayout>

                <!-- Catégories -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="6dp">

                    <ImageView
                        android:id="@+id/cat"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:src="@drawable/morinf"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/categories"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/textCategories"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/categories"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:shadowColor="#AA000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="1.5"
                        style="@style/TeamText" />
                </LinearLayout>

                <!-- Sites -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="6dp">

                    <ImageView
                        android:id="@+id/site"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:src="@drawable/site"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/site"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/sitee"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/site"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:shadowColor="#76E4A7A7"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="1.5"
                        style="@style/TeamText" />
                </LinearLayout>
            </LinearLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
